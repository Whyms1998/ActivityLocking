<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      ★ v1.34.1：WebDAV 云同步。本 App 其余部分全程离线，网络只用于「上传/下载一个备份 JSON」。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 使用情况访问权限：声明后 App 才会出现在系统"使用情况访问权限"列表里（特殊权限，用户手动授予） -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      ★ 包可见性（Android 11+ 必需，否则 getInstalledPackages() 被 AppsFilter 拦截）：
      本 App 的核心能力是"选择任意应用/任意界面来锁定"，必须能看到全部已安装应用。
      仅声明 QUERY_ALL_PACKAGES 权限并不授予可见性——可见性由 <queries> 决定，
      缺少本段时 system apps queryable=false，列表会时有时无（表现为"权限偶尔失效"）。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".LockApp"
        android:label="应用锁"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ActivityLock">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              长按任意应用锁磁贴 → 直接打开本 App（替代默认的"应用信息"）。
              ★ 两个关键点（真机实测踩出来的，缺一不可）：
              1. category DEFAULT —— 系统长按发的是隐式 intent，没有 DEFAULT 类别
                 根本不会被匹配（v1.5.1~v1.29.1 一直缺这条，长按等于摆设）。
              2. priority=999 —— HyperOS 的 SystemUI 发的是没有 component/package
                 的裸隐式 intent，系统里其它声明了该 action 的应用（com.android.settings
                 开发者选项、permissioncontroller、com.android.camera 等）会一起命中，
                 弹"选择要使用的应用"选择器。PackageManagerService.chooseBestActivity()
                 规则：候选里优先级严格最高者直接胜出不弹选择器 → 拉到 999（其余默认 0）。
              ※ v1.30.0 修复：v2.0.0 重构曾把这段写进一个从未创建的 TilePrefsActivity，
                导致长按 startActivity 抛 ActivityNotFoundException 被 SystemUI 吞掉。
            -->
            <intent-filter android:priority="999">
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.InspectorService"
            android:exported="false"
            android:label="Activity 查询"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/inspector_service_config" />
        </service>

        <activity
            android:name=".UnlockGateActivity"
            android:exported="false"
            android:theme="@style/Theme.UnlockGate" />

        <activity
            android:name=".QuotaGateActivity"
            android:exported="true"
            android:theme="@style/Theme.UnlockGate" />

        <!-- 特赦磁贴的直达验证页：透明背景，只显示验证卡片，通过即放行并关闭。
             exported=false —— 只由本应用的磁贴服务内部拉起，不允许外部唤起。 -->
        <activity
            android:name=".AmnestyApplyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.UnlockGate" />

        <receiver
            android:name=".core.AdminReceiver"
            android:description="@string/admin_description"
            android:label="防卸载保护"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".core.TempUnlockTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_key"
            android:label="特赦"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".ui.TempUnlockActivity"
            android:exported="false"
            android:theme="@style/Theme.UnlockGate" />

        <service
            android:name=".core.FocusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="focus-session-timer" />
        </service>

        <service
            android:name=".core.QuotaService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="usage-quota-monitor" />
        </service>

        <service
            android:name=".core.AutoRelockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="app-auto-relock-guard" />
        </service>

        <receiver
            android:name=".core.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".core.LockAllTileService"
            android:exported="true"
            android:label="全部上锁"
            android:icon="@drawable/ic_tile_lock"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".core.UnlockAllTileService"
            android:exported="true"
            android:label="全部解锁"
            android:icon="@drawable/ic_tile_unlock"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>


        <!--
          ※ v1.30.0 已删除原 .core.TilePrefsActivity 声明：该类从未存在于源码
            （v2.0.0 重构只写进了清单），运行时长按磁贴会因找不到组件被 SystemUI
            静默吞掉。长按逻辑现由 MainActivity 自己的 QS_TILE_PREFERENCES
            filter（DEFAULT + priority=999）承接，见上方注释。
        -->

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
